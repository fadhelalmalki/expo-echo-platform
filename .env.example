# --- Expo Echo environment variables ---

# Spring profile: dev (H2 in-memory) or prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# OpenRouter (Spring AI). Set AI_ENABLED=true after adding your key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_ENABLED=false

# PostgreSQL (Railway provides these automatically in prod)
# PGHOST=
# PGPORT=
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Simulated Expo site center on the map
SITE_CENTER_LAT=24.7690
SITE_CENTER_LNG=46.6580
